mapscripts VictoryRoad_2F_MapScripts {}

script VictoryRoad_2F_EventScript_FloorSign {
    msgbox(VictoryRoad_2F_Text_FloorName, MSGBOX_SIGN)
}

script VictoryRoad_2F_EventScript_PuzzleRayquaza {
    lockall
    playbgm(MUS_PUZZLE_FINAL, 0)
    playslidingblocks(SLIDING_LAYOUT_RAYQUAZA)
    fadedefaultbgm
    releaseall
}
