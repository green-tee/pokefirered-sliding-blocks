VictoryRoad_2F_Text_ThisIsTheFinalPuzzle::
# 42 "data/maps/VictoryRoad_2F/text.pory"
	.string "Greetings, challenger!\n"
	.string "You made your way to the final\l"
	.string "puzzle of BRAINING PALACE.\p"
	.string "There are no new rules,\n"
	.string "only a final obstacle in your path\l"
	.string "to victory.\p"
	.string "Do your best!$"

VictoryRoad_2F_Text_ImTheMasterBot::
# 52 "data/maps/VictoryRoad_2F/text.pory"
	.string "Challenger! I am the MASTER BOT.\n"
	.string "I am the real final trial\l"
	.string "of BRAINING PALACE.\p"
	.string "Do you want to add your name to our\n"
	.string "HALL OF FAME?\p"
	.string "Of course! Who wouldn't, having come\n"
	.string "this far?\p"
	.string "Let the trial begin!$"

