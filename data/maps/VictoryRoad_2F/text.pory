text VictoryRoad_2F_Text_FloorName {
    "Floor VII\n"
    "-- The final piece of the puzzle --"
}

text VictoryRoad_2F_Text_Credits {
    "POKéMON - LET IT SLIDE!\n"
    "CREDITS\p"
    "AUTHOR - Nicolavs\n"
    "BASE GAME - GAME FREAK\l"
    "DECOMPILATION - pret\p"
    "GRAPHICS\n"
    "GAME FREAK\l"
    "Nicolavs\l"
    "Protagonist's sprites: hyo\l"
    "Eusine's sprites: Project Palladium\p"
    "MUSIC\n"
    "GAME FREAK\l"
    "Level 5\l"
    "Title theme: Unknown artist\l"
    "Overworld theme: Bulgasali\l"
    "Battle theme: Daniel Lawrence\l"
    "Puzzles theme 1: Unknown artist\l"
    "Puzzles theme 2: (MoldyPond)\l"
    "Puzzles theme 3: Unknown artist\l"
    "Puzzles theme 4: Unknown artist\l"
    "Puzzles theme 5: Unknown artist\l"
    "Final battle theme: Xenu\p"
