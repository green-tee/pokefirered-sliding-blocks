text VictoryRoad_1F_Text_FloorName {
    "Floor VI\n"
    "-- Master of all trades --"
}

text VictoryRoad_1F_Text_NothingHappened {
    "Nothing happened."
}

text VictoryRoad_1F_Text_ImpossibleNothingHappened {
    "{FONT_SMALL}This puzzle is supposed to be impossible.\n"
    "Nothing happened."
}

text VictoryRoad_1F_Text_MagicSquare {
    "This puzzle is called\n"
    "a magic square.\p"
    "Arrange the tiles so that all rows,\n"
    "all columns and both diagonals\l"
    "add up to the same number.\p"
    "The empty space is equal to 1."
}

text VictoryRoad_1F_Text_RockerIntro {
    "You won't go any further\n"
    "without a battle!"
}

text VictoryRoad_1F_Text_RockerDefeated {
    "I failed to stop you.\n"
    "You deserve to keep going."
}

text VictoryRoad_1F_Text_ImStuck {
    "I think I'm stuck here, am I not?"
}

text VictoryRoad_1F_Text_ThisIsTooDifficult {
    "This is too difficult!\n"
    "I'm not cut for these puzzles!"
}

text VictoryRoad_1F_Text_ImLookingForMetragross {
    "I'm looking for METAGROSS,\n"
    "but I don't know how rare it is.\p"
    "I've been looking for half an hour!"
}
