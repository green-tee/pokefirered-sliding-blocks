script VictoryRoad_1F_EventScript_PuzzleGolem {
    lockall
    playbgm(MUS_PUZZLE_LOST_WOODS, 0)
    playslidingblocks(SLIDING_LAYOUT_GOLEM)
    fadedefaultbgm
    if (var(VAR_RESULT) != 0) {
        msgbox(VictoryRoad_1F_Text_ImpossibleNothingHappened, MSGBOX_DEFAULT)
