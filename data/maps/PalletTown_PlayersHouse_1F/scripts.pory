mapscripts PalletTown_PlayersHouse_1F_MapScripts {}

script PalletTown_PlayersHouse_1F_EventScript_Mom {
    msgbox(PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocks, MSGBOX_DEFAULT)
    closemessage
    playslidingblocks(SLIDING_LAYOUT_NUMBERS_1234)
    msgbox(PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocksDone, MSGBOX_DEFAULT)
    closemessage
    release
}

script PalletTown_PlayersHouse_1F_EventScript_TV {lock
    msgbox(PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocks, MSGBOX_DEFAULT)
    closemessage
    playslidingblocks(SLIDING_LAYOUT_NUMBERS_1)
    msgbox(PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocksDone, MSGBOX_DEFAULT)
    closemessage
    release
}

script PalletTown_PlayersHouse_1F_EventScript_Psyduck {
    msgbox(PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocks, MSGBOX_DEFAULT)
    closemessage
    playslidingblocks(SLIDING_LAYOUT_NUMBERS_3X3)
    msgbox(PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocksDone, MSGBOX_DEFAULT)
    closemessage
    release
}

text PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocks {
    "Texting whether sliding blocks works."
}

text PalletTown_PlayersHouse_1F_Text_TestingSlidingBlocksDone {
    "Testing finished."
}

script PalletTown_PlayerHouse_1F_EventScript_ProfOak {
    lock
    faceplayer
    msgbox(PalletTown_PlayerHouse_1F_Text_WantPokemon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox(PalletTown_PlayerHouse_1F_Text_HereYouAre, MSGBOX_DEFAULT)
        givemon(SPECIES_ABSOL, 35)
        playfanfare(MUS_OBTAIN_KEY_ITEM)
    }
    closemessage
    release
}

text PalletTown_PlayerHouse_1F_Text_WantPokemon {
    "Do you want a Pokémon?"
}

text PalletTown_PlayerHouse_1F_Text_HereYouAre {
    "OK, here you are."
}
