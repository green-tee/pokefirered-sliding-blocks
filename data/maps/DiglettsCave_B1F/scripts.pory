mapscripts DiglettsCave_B1F_MapScripts {
    MAP_SCRIPT_ON_LOAD: DiglettsCave_B1F_OnLoad
}

script DiglettsCave_B1F_OnLoad {
    if (!flag(FLAG_SOLVED_HO_OH_BACK_SHINY)) {
        call(DiglettsCave_B1F_EventScript_SetPuzzleHoOhBackShiny)
    }
}

script DiglettsCave_B1F_EventScript_PuzzleHoOhBackShiny {
    if (!flag(FLAG_SOLVED_HO_OH_BACK_SHINY)) {
        lockall
        playslidingblocks(SLIDING_LAYOUT_HO_OH_BACK_SHINY)
        if (var(VAR_RESULT) != 0) {
            setflag(FLAG_SOLVED_HO_OH_BACK_SHINY)
            removeobject(VAR_LAST_TALKED)
            playse(SE_UNLOCK)
            call(DiglettsCave_B1F_EventScript_ClearPuzzleHoOhBackShiny)
            special(DrawWholeMapView)
        }
        releaseall
    }
}

script DiglettsCave_B1F_EventScript_PuzzleHoOhBackShinyUnsolvable1 {
    lockall
    playslidingblocks(SLIDING_LAYOUT_HO_OH_BACK_SHINY_UNSOLVABLE_1)
    if (var(VAR_RESULT) != 0) {
        msgbox(DiglettsCave_B1F_Text_ThisPuzzleIsUnsolvable, MSGBOX_DEFAULT)
        closemessage
    }
    releaseall
}

