mapscripts SevenIsland_TrainerTower_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MAP_SCENE_BRAINING_ISLAND, 0: SevenIsland_TrainerTower_EventScript_Intro
        VAR_MAP_SCENE_BRAINING_ISLAND, 2: SevenIsland_TrainerTower_EventScript_Ending
    ]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_MAP_SCENE_BRAINING_ISLAND, 0: SevenIsland_TrainerTower_EventScript_TurnPlayerNorth
    ]
    MAP_SCRIPT_ON_TRANSITION: SevenIsland_TrainerTower_OnTransition
}

script SevenIsland_TrainerTower_OnTransition {
    setrespawn(HEAL_LOCATION_SEVEN_ISLAND_TRAINER_TOWER)
}

script SevenIsland_TrainerTower_EventScript_PalaceSign {
    msgbox(SevenIsland_TrainerTower_Text_PuzzlePalace, MSGBOX_SIGN)
}

script SevenIsland_TrainerTower_EventScript_TurnPlayerNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script SevenIsland_TrainerTower_EventScript_Intro {
    lockall
    delay(30)
    msgbox(SevenIsland_TrainerTower_Text_WelcomeToBrainingIsland, MSGBOX_DEFAULT)
    closemessage
    playmoncry(SPECIES_HO_OH, CRY_MODE_NORMAL)
    applymovement(LOCALID_HO_OH, SevenIsland_TrainerTower_Movement_WalkDown)
    waitmovement(LOCALID_HO_OH)
    msgbox(SevenIsland_TrainerTower_Text_HoOh, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_HO_OH, SevenIsland_TrainerTower_Movement_WalkDown)
    waitmovement(LOCALID_HO_OH)
    removeobject(LOCALID_HO_OH)
    givemon(SPECIES_HO_OH, 50, ITEM_SMOKE_BALL)
    setflag(FLAG_SYS_POKEMON_GET)
    msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        call(EventScript_GetGiftMonPartySlot)
	    call(EventScript_ChangePokemonNickname)
    }
    giveitem(ITEM_ITEMFINDER)
    msgbox(SevenIsland_TrainerTower_DoYourBest, MSGBOX_DEFAULT)
    closemessage
    addvar(VAR_MAP_SCENE_BRAINING_ISLAND, 1)
    releaseall
}

movement SevenIsland_TrainerTower_Movement_WalkDown {
    walk_down
}

script SevenIsland_TrainerTower_EventScript_Ending {
    lockall
    delay(30)
    msgbox(SevenIsland_TrainerTower_ThankYouForPlaying, MSGBOX_DEFAULT)
    closemessage
    delay(30)
    applymovement(LOCALID_PLAYER, SevenIsland_TrainerTower_Movement_WalkAway1)
    waitmovement(LOCALID_PLAYER)
    applymovement(LOCALID_PLAYER, SevenIsland_TrainerTower_Movement_WalkAway2)
    fadescreenspeed(FADE_TO_BLACK, 16)
    waitmovement(LOCALID_PLAYER)
    fadeoutbgm(0)
    delay(120)
    special(DoSoftReset)
    delay(30)
    releaseall
}

movement SevenIsland_TrainerTower_Movement_WalkAway1 {
    walk_down * 6
}

movement SevenIsland_TrainerTower_Movement_WalkAway2 {
    walk_down * 10
}
