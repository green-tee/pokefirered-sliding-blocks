text SevenIsland_TrainerTower_Text_PuzzlePalace {
    "Welcome to BRAINING PALACE!"
}

text SevenIsland_TrainerTower_Text_WelcomeToBrainingIsland {
    "Welcome to BRAINING ISLAND!\n"
    "This is a place in the middle\l"
    "of the ocean, with nothing to do\l"
    "but take on the challenge\l"
    "of BRAINING PALACE.\p"
    "The reward for beating it is…\n"
    "Nothing! Nothing but glory!"
}

text SevenIsland_TrainerTower_Text_HoOh {
    "HO-OH, the Pokémon you befriended\n"
    "a long time ago, shall come along."
}

text SevenIsland_TrainerTower_DoYourBest {
    "Do your best!"
}

text SevenIsland_TrainerTower_ThankYouForPlaying {
    "Thank your for playing\n"
    "POKéMON - LET IT SLIDE!\p"
    "This project was made for the\n"
    "{FONT_SMALL}3rd Team Aqua's ROM-Hacking Competition{FONT_NORMAL}\l"
    "(TARC3).\p"
    "We hope you enjoyed your time\n"
    "with it!"
}
